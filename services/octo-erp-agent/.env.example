# Si se deja vacío, el servidor MCP y cualquier script usan InMemoryRepository
# (datos semilla en memoria, sin Azure) — ver src/octo_erp_agent/repositories/in_memory.py.
# Con esto seteado, usan CosmosRepository — la fuente de verdad real (ver
# docs/decisions/004-agente-ia-mcp-cosmosdb.md).
COSMOS_ENDPOINT=

# Opcional, mismo formato que oraculo/.env.example
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
